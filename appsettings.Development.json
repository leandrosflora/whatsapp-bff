{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WhatsApp": {
    "PhoneNumberId": "",
    "AccessToken": "",
    "AppSecret": "local-dev-app-secret",
    "VerifyToken": "local-dev-verify-token",
    "GraphApiBaseUrl": "https://graph.facebook.com/v20.0"
  },
  "Orchestrator": {
    // conversation-orchestrator's local dev port per its own launchSettings.json http profile.
    "BaseUrl": "http://localhost:5268"
  },
  "Kafka": {
    // Port 9092 is Kafka's PLAINTEXT listener, advertised as "kafka:9092" - only resolvable
    // from inside the Docker network. 29092 is the EXTERNAL listener, advertised as
    // "localhost:29092", for clients running on the host (e.g. this app via `dotnet run`/VS).
    "BootstrapServers": "localhost:29092",
    "MessageReceivedTopic": "channel.message.received",
    "MessageStatusTopic": "channel.message.status",
    "RawWebhookReceivedTopic": "channel.webhook.received",
    "WebhookConsumerGroupId": "whatsapp-bff-webhook-consumer"
  }
}
